<apex:page showHeader="false" sidebar="false" standardStylesheets="false" renderAs="pdf" applyHtmlTag="false"
    applyBodyTag="false" standardController="Quote" extensions="SalesPdfChakrMarjakController">

    <html>

    <head>
        <style type="text/css">
            @page {
                size: A4;
                margin: 10mm;
            }

            body {
                font-family: Cambria, Arial, sans-serif;
                font-size: 10pt;
                color: #000;
            }

            .title {
                text-align: center;
                color: #2F5597;
                font-size: 14pt;
                font-weight: bold;
            }

            .subtitle {
                text-align: center;
                font-size: 10pt;
                font-weight: bold;
                margin-bottom: 15px;
            }

            .sectionHeading {
                color: #2F5597;
                font-weight: bold;
                font-size: 12pt;
                margin-top: 12px;
                margin-bottom: 4px;
            }

            .tbl {
                width: 100%;
                border-collapse: collapse;
                margin-top: 3px;
                margin-bottom: 12px;
            }

            .tbl th {
                border: 1px solid #000;
                padding: 3px;
                text-align: left;
                font-weight: bold;
                font-size: 9pt;
            }

            .tbl td {
                border: 1px solid #000;
                padding: 3px;
                font-size: 9pt;
            }

            .normalText {
                font-size: 9pt;
                margin-bottom: 2px;
            }
        </style>
    </head>

    <body>

        <!-- HEADER -->

        <table width="100%" cellpadding="0" cellspacing="0">
            <tr>

                <td width="25%" valign="top">
                    <img src="{!$Resource.ChakrLogo}" width="75" />
                </td>


                <td width="45%">
                </td>

                <td width="30%" valign="top" align="right" style="font-size:8pt;color:#666666;">

                    Tel: +91-124-4084599<br />
                    URL:
                    <span style="color:blue;text-decoration:underline;">
                        www.chakr.in
                    </span>
                    <br />

                    mail:
                    <span style="color:blue;text-decoration:underline;">
                        info@chakr.in
                    </span>

                </td>

            </tr>
        </table>

        <br />

        <!-- TITLE -->

        <div class="title">
            BUDGETARY QUOTATION
        </div>

        <div class="subtitle">
            Chakr Marjak - Pneumatic-Assisted Sludge Evacuation System for {!quoteRec.Category__c}
        </div>

        <!-- META style="font-size:9pt;"-->

        <table width="100%" style="table-layout:fixed; font-size:9pt;">
            <tr>
                <!-- LEFT SIDE -->
                <td width="48%" valign="top">

                    <table width="100%">
                        <tr>
                            <td width="25%">
                                Category:
                            </td>
                            <td width="75%">
                                {!quoteRec.Category__c}
                            </td>
                        </tr>

                        <tr>
                            <td valign="top">
                                Submitted To:
                            </td>
                            <td style="word-wrap:break-word;">
                                {!quoteRec.Submitted_To__c}
                            </td>
                        </tr>
                    </table>

                </td>

                <!-- MIDDLE GAP -->
                <td width="8%"></td>

                <!-- RIGHT SIDE -->
                <td width="44%" valign="top">

                    <table width="100%">
                        <tr>
                            <td width="30%">
                                Quotation No:
                            </td>
                            <td width="70%">
                                CHK_P_
                                <apex:outputText value="{0,date,yyyy-MM-dd}">
                                    <apex:param value="{!quoteRec.createdDate}" />
                                </apex:outputText>_{!quoteRec.QuoteNumber}

                            </td>
                        </tr>

                        <tr>
                            <td>
                                Date:
                            </td>
                            <td>
                                <apex:outputText value="{0,date,dd-MMMM-yy}">
                                    <apex:param value="{!quoteRec.createdDate}" />
                                </apex:outputText>
                            </td>
                        </tr>
                    </table>

                </td>
            </tr>
        </table>

        <br />

        <!-- COMMERCIAL OFFER -->

        <div class="sectionHeading">
            Commercial Offer for {!FLOOR(qliRec.Quantity)} Devices.
        </div>

        <table class="tbl">

            <tr>
                <th width="60%">
                    Description
                </th>

                <th width="40%">
                    Amount (INR)
                </th>
            </tr>

            <tr>
                <td>Device (Ex-Works, Ex-GST)</td>
                <td>
                    <apex:outputText value="{0, number, ###,###,##0.00}">
                        <apex:param value="{!qliRec.TotalPrice}" />
                    </apex:outputText>
                </td>
            </tr>

            <tr>
                <td>GST @ 18%</td>
                <td>
                    <apex:outputText value="{0, number, ###,###,##0.00}">
                        <apex:param value="{!gstAmount}" />
                    </apex:outputText>
                </td>
            </tr>

            <tr>
                <td>Total Device Cost (Incl. GST)</td>
                <td>
                    <apex:outputText value="{0, number, ###,###,##0.00}">
                        <apex:param value="{!totalDeviceCost}" />
                    </apex:outputText>
                </td>
            </tr>

        </table>

        <!-- MAINTENANCE -->

        <div class="sectionHeading">
            Maintenance
        </div>

        <table class="tbl">

            <tr>
                <th width="60%">
                    Particulars
                </th>

                <th width="40%">
                    Amount
                </th>
            </tr>

            <tr>
                <td>Maintenance Support – Year 1</td>
                <td>Included</td>
            </tr>

            <tr>
                <td>AMC from Year 2 onwards</td>
                <td>20% of Device Cost per Year</td>
            </tr>

        </table>

        <!-- PAYMENT TERMS -->

        <div class="sectionHeading">
            Payment Terms
        </div>

        <div class="normalText" style=" white-space:pre-line;">
            {!quoteRec.Payment__c}
        </div>

        <br />

        <!-- COMMERCIAL NOTES -->

        <!-- Bottom Section -->

        <table width="100%" cellpadding="0" cellspacing="0" border="0">

            <tr>

                <!-- LEFT COLUMN -->
                <td width="68%" valign="top">

                    <div class="sectionHeading">
                        Commercial Notes
                    </div>

                    <div class="normalText">
                        Freight charges extra at actuals.
                    </div>

                    <div class="normalText">
                        GST applicable as per prevailing rates.
                    </div>

                    <div class="normalText">
                        AMC applicable from Year 2 onwards.
                    </div>

                    <!-- little space -->
                    <div style="height:12px;"></div>

                    <div style="font-size:9pt;">
                        {!quoteOwner.Name}
                    </div>

                    <div style="font-size:9pt;">
                        {!quoteOwner.Title}
                    </div>

                    <div style="font-size:9pt;">
                        M: {!quoteOwner.MobilePhone}
                    </div>

                    <div style="font-size:9pt;">
                        E:
                        <span style="color:blue;text-decoration:underline;">
                            {!quoteOwner.Email}
                        </span>
                    </div>

                </td>

                <!-- RIGHT COLUMN -->
                <td width="32%" align="center" valign="middle">

                    <img src="{!$Resource.ChakrStamp}" width="135" height="140" />

                </td>

            </tr>

            <tr>

                <td colspan="2" style="padding-top:10px;">

                    <span class="sectionHeading">
                        Terms &amp; Conditions:
                    </span>

                    <br />

                    <div style="font-size:9pt; white-space:pre-line;">
                        {!quoteRec.Terms_And_Conditions__c}
                    </div>
                </td>

            </tr>

        </table>

    </body>

    </html>
</apex:page>