<apex:page standardController="Quote" extensions="SalesQuoteController"  renderAs="pdf"  standardStylesheets="false" applyHtmlTag="false" showHeader="false">
    
    <head>
        <style type="text/css">
            @page {
            size: A4;
            border: 1px solid black;
            padding-left:10px;
            margin-bottom: 35mm;
            margin-top: 30mm;
            @top-center {
            content: element(header);
            }
            @bottom-center {
            content: element(footer);
            }
            }
            div.header {
            padding: 10px;
            position: running(header);
            }
            div.footer {
            display: block;
            padding: 5px;
            position: running(footer);
            }
            table td {
            padding: 1;
            border-collapse:collapse;
            }
            
            table.tmain{
            -fs-table-paginate: paginate;
            border-collapse:collapse;
            border-spacing: 0;
            }
            table, tr {
            border: 1px solid black;
            border-collapse: collapse;
            }
            
            table tr{
            page-break-inside:avoid;
            }
            
            ol.inner-list {
            list-style-type: lower-alpha; /* Changes to a, b, c... */
            }
        </style>
    </head>
