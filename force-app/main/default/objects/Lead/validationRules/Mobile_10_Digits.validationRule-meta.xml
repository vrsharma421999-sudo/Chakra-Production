<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Mobile_10_Digits</fullName>
    <active>false</active>
    <errorConditionFormula>NOT(REGEX( MobilePhone , &quot;^[0-9]{10}&quot;))</errorConditionFormula>
    <errorDisplayField>MobilePhone</errorDisplayField>
    <errorMessage>Mobile should be of 10 digits</errorMessage>
</ValidationRule>
