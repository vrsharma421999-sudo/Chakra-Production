    <description>This flow is used to create Contract Record from PO Verification. This Flow is Called when user clicks on the Create Contract button on the PO Verification Record.</description>
    <environments>Default</environments>
    <formulas>
        <name>AMC_Close_Date</name>
        <dataType>Date</dataType>
        <expression>DATE(
    YEAR({!POLineItemVar.Contract_End_Date__c}) + VALUE(LEFT(TEXT({!get_Verification_Record.AMC_Year__c}), 1)),
    MONTH({!POLineItemVar.Contract_End_Date__c}),
    DAY({!POLineItemVar.Contract_End_Date__c})
) - 1</expression>
    </formulas>
    <formulas>
        <name>AMC_Renewal_Name</name>
        <dataType>String</dataType>
        <expression>&quot;AMC Renewal_&quot; + {!Get_Original_Deal.Name}</expression>
    </formulas>
    <formulas>
        <name>fAMCYears</name>
        <dataType>Number</dataType>
        <expression>CASE({!get_Verification_Record.AMC_Year__c}, 
&quot;1 Year&quot;, 1, 
&quot;2 Year&quot;, 2, 
&quot;3 Year&quot;, 3, 
&quot;5 Year&quot;, 5, 
0)</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Create Contract from PO Verification {!$Flow.CurrentDateTime}</interviewLabel>
